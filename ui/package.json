{
  "name": "limbo-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Limbo's browser chrome: title bar, tabs, omnibox, menus and internal pages.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/check-budget.mjs",
