{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "ui",
  "description": "Limbo's own UI webview. Web pages (tab webviews) get no capabilities at all.",
  "local": true,
  "windows": [
    "main"
  ],
  "webviews": [
    "ui"
  ],
  "permissions": [
    "core:event:default",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    "allow-app-state",
    "allow-app-ready",
    "allow-prompt-respond",
    "allow-shortcut",
    "allow-tabs-create",
    "allow-tabs-close",
    "allow-tabs-activate",
    "allow-tabs-move",
    "allow-tabs-pin",
    "allow-tabs-mute",
    "allow-tabs-duplicate",
    "allow-tabs-reopen-closed",
    "allow-tabs-snapshot",
    "allow-nav-go",
    "allow-nav-url",
    "allow-nav-back",
    "allow-nav-forward",
    "allow-nav-reload",
    "allow-nav-stop",
    "allow-layout-set-insets",
    "allow-overlay-capture",
    "allow-overlay-hide-content",
    "allow-overlay-show-content",
    "allow-suggest-query",
    "allow-suggest-remove",
    "allow-history-search",
    "allow-history-delete",
    "allow-clear-browsing-data",
    "allow-top-sites",
    "allow-favicon-for",
    "allow-bookmarks-tree",
    "allow-bookmarks-add",
    "allow-bookmarks-update",
    "allow-bookmarks-move",
    "allow-bookmarks-remove",
    "allow-bookmarks-restore",
    "allow-bookmarks-for-url",
    "allow-bookmarks-import-html",
    "allow-bookmarks-export-html",
    "allow-passwords-list",
    "allow-passwords-for-tab",
    "allow-passwords-reveal",
    "allow-passwords-delete",
    "allow-passwords-export",
    "allow-passwords-import-csv",
    "allow-autofill-fill",
    "allow-ext-list",
    "allow-ext-prepare-store",
    "allow-ext-prepare-file",
    "allow-ext-confirm",
    "allow-ext-load-unpacked",
    "allow-ext-remove",
    "allow-ext-set-enabled",
    "allow-ext-set-pinned",
    "allow-ext-open-popup",
    "allow-ext-close-popup",
    "allow-ext-open-options",
    "allow-import-detect",
    "allow-import-choose-folder",
    "allow-import-run",
    "allow-downloads-list",
    "allow-downloads-control",
    "allow-downloads-open",
    "allow-downloads-show-in-folder",
    "allow-downloads-remove",
    "allow-downloads-clear",
    "allow-site-permissions",
    "allow-site-permission-revoke",
    "allow-settings-get",
    "allow-settings-set",
    "allow-find-start",
    "allow-find-step",
    "allow-find-stop",
    "allow-zoom-step",
    "allow-window-minimize",
    "allow-window-toggle-maximize",
    "allow-window-close",
    "allow-window-toggle-fullscreen",
    "allow-window-snap-layouts",
    "allow-memory-set-sampling",
    "allow-memory-sleep-tab",
    "allow-memory-unload-tab",
    "allow-memory-sleep-all",
    "allow-memory-set-max-awake",
    "allow-memory-set-preset",
    "allow-print-page",
    "allow-devtools-open",
    "allow-default-browser-open",
    "allow-default-browser-status"
  ]
}
